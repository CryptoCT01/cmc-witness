    "duel": "tsx src/demo/duel.ts",
    "console": "tsx src/demo/console-server.ts",
    "demo": "tsx src/demo/console-server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [

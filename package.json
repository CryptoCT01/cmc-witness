  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/axios": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "viem": "^2.56.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"

  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cmc-witness": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",

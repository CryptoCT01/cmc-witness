# --- CMC Witness / Court of Markets ---
# Prefer x402 (USDC on Base, ~$0.01/call). No CMC API key required for that path.

# Wallet private key for x402 payments on Base (eip155:8453). NEVER commit real keys.
# Fund with a small amount of USDC on Base.
EVM_PRIVATE_KEY=
# Alias accepted by createCmcClient (same as EVM_PRIVATE_KEY):
# X402_PRIVATE_KEY=

# Optional fallback: classic CMC Pro API key (header X-CMC_PRO_API_KEY)
CMC_API_KEY=

# Force data mode: auto | x402 | key | fixture
# fixture = offline dry-run using fixtures/ (no keys, no network)
CMC_WITNESS_MODE=auto

# Where to append Market Receipt JSONL lines (tamper-evident chain)
CMC_WITNESS_RECEIPT_LOG=./receipts/market-receipts.jsonl

# Judge Console port (default 4173)
# CMC_WITNESS_CONSOLE_PORT=4173

# Optional Base RPC (defaults to public Base RPC via viem)
# BASE_RPC_URL=https://mainnet.base.org
